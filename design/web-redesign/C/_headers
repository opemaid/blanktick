# Cloudflare Pages headers for blanktick.org
# The page makes zero third-party requests; the policy below says so in a way
# a reader can verify in the network tab. Styles and fonts are self-hosted
# (font-src 'self'). Direction C has no inline style= attributes, so
# 'unsafe-inline' could be dropped from style-src; it is left as-is pending
# review. No scripts load.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

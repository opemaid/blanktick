# ---------------------------------------------------------------- build output
build/
.gradle/
.kotlin/
*.hprof
desktop/build/
app/build/
core/build/

# --------------------------------------------------------------- machine-local
# Contains an absolute SDK path from whoever built it. Never useful to anyone else.
local.properties
.idea/
*.iml
.DS_Store

# ------------------------------------------------------- generated threat data
# Built by tools/build_intel.py, roughly 20 MiB at shipping size, and derived
# rather than authored. `tools/seeds/` holds the inputs, which ARE tracked.
#
# A developer clone without these still builds and runs: every accessor degrades
# to null and the rules that need them report "not checkable" rather than
# silently passing. That is the same contract the collectors follow.
app/src/main/assets/intel/*.mub
app/src/main/assets/intel/*.mus
app/src/main/assets/intel/manifest.txt
desktop/src/main/resources/intel/*.mub
desktop/src/main/resources/intel/*.mus
desktop/src/main/resources/intel/manifest.txt

# ----------------------------------------------------------- release artefacts
dist/
*.msi
*.dmg
*.deb

# ---------------------------------------------------------------- PRIVACY
# Screenshots captured from a real machine during development.
#
# This is not tidiness. A full-screen capture of a Mume scan shows the operator's
# taskbar, installed applications, clock, weather/location, and — because the app
# works — their actual findings: local administrator account names, DNS resolver
# addresses, the services listening on their machine. Publishing those to an open
# repository would leak exactly the data the product exists to keep local.
#
# Screenshots for documentation must come from a clean VM or be synthetic. If you
# need one committed, put it in docs/shots/public/ and check it by eye first.
docs/shots/
!docs/shots/public/

# Regenerated by opening design/directions-bold.html; underscore-prefixed files
# in design/ are render output, not source.
design/_*.png
